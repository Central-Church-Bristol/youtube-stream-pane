{
  "name": "live-pane",
  "productName": "Live Pane",
  "private": true,
  "version": "1.1.0",
  "author": "Central Church Bristol",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --port 43147 --host 127.0.0.1 --strictPort",
    "desktop": "cross-env LIVE_PANE_DEV=1 concurrently -k \"npm.cmd run dev\" \"wait-on http://127.0.0.1:43147 && cross-env LIVE_PANE_DEV=1 electron .\"",
    "build": "tsc -b && vite build",
    "start": "node server/http.mjs",
    "preview": "vite preview --port 43147 --host 127.0.0.1 --strictPort",
    "lint": "oxlint",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "church.livepane",
    "productName": "Live Pane",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["*.ps1"]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "LivePane-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Live Pane",
      "uninstallDisplayName": "Live Pane",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true
    }
  }
}
